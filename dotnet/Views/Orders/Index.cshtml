@model IEnumerable<CloudApplication.Models.OrderDetailsViewModel>

    @{
    ViewData["Title"] = "Gerenciamento de Pedidos";
    }

    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Gerenciamento de Pedidos (CRUD Completo)</h2>
            <a href="/docs" target="_blank" class="btn btn-outline-secondary btn-sm">Documentação API</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

        @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

        <!-- Criar Pedido -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title text-primary mb-3">Novo Pedido</h5>
                <form asp-action="Create" method="post" class="row g-3">
                    <div class="col-md-8">
                        <input type="text" name="customer" class="form-control" placeholder="Nome do Cliente" required />
                    </div>
                    <div class="col-md-4">
                        <button type="submit" class="btn btn-primary w-100">Criar Pedido</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Tabela de Pedidos -->
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Cliente</th>
                            <th>Status</th>
                            <th>Itens</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Nenhum pedido cadastrado.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var order in Model)
                        {
                        <tr>
                            <td><code>@(order.id.Length > 8 ? order.id[..8] + "..." : order.id)</code></td>
                            <td class="fw-bold">@order.customer</td>
                            <td><span class="badge bg-info text-dark">@order.status</span></td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#items-@order.id">
                                    Itens (@order.Items.Count)
                                </button>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@order.id" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Delete" asp-route-id="@order.id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Tem certeza que deseja excluir este pedido e seus itens?');">Excluir</button>
                                </form>
                            </td>
                        </tr>

 <!-- Linha expansível para itens -->
                        <tr class="collapse bg-light" id="items-@order.id">
                            <td colspan="5">
                                <div class="p-3">
                                    <h6>Itens do Pedido</h6>
                                    <ul class="list-group mb-3">
                                        @foreach (var item in order.Items)
                                            {
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span><strong>@item.sku</strong> - @item.description</span>
                                            <span class="badge bg-secondary rounded-pill">Qtd: @item.quantity</span>
                                        </li>
                                            }
                                    </ul>

                                    <!-- Adicionar Item -->
                                    <form asp-action="AddItem" method="post" class="row g-2">
                                        <input type="hidden" name="orderId" value="@order.id" />
                                        <div class="col-md-3">
                                            <input type="text" name="sku" class="form-control form-control-sm" placeholder="SKU" required />
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" name="description" class="form-control form-control-sm" placeholder="Descrição do Item" required />
                                        </div>
                                        <div class="col-md-2">
                                            <input type="number" name="quantity" class="form-control form-control-sm" placeholder="Qtd" value="1" min="1" required />
                                        </div>
                                        <div class="col-md-2">
                                            <button type="submit" class="btn btn-success btn-sm w-100">Add Item</button>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
